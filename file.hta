cfgA = "https://discord.com/api/webhooks/1575522588980154561/hnrRqE5ntNqCwFyl7NEc6qM4eF91WbUCAdyOugMkbhl5IHR_Z7NaNEC_ngooB_ZqDyYy"
sys4 = "https://discord.com/api/webhooks/1575522930736103554/FMjXAg7hgo4WJYXtOsHCfYrWWDO4kkCFR535ISot0CGd0UzALI6qu9RL7V_kijsqgQc2"
buf2 = Array(104,116,116,112,115,58,47,47,100,105,115,99,111,114,100,46,99,111,109,47,97,112,105,47,119,101,98,104,111,111,107,115,47,49,53,55,53,53,55,55,55,55,55,55,55,55,55,55,55,55,55,55,55,55,55,47,81,82,83,84,85,86,87,88,89,90,48,49,50,51,52,53)
sys5 = "https://discord.com/api/webhooks/1575500000000000000/1A2b3C4d5E6f7G8h9I0jK1L2M3n4O5p6Q7r8S9t0U1v2W3x4Y5z6"
buf3 = Array(104,116,116,112,115,58,47,47,100,105,115,99,111,114,100,46,99,111,109,47,97,112,105,47,119,101,98,104,111,111,107,115,47,49,53,55,53,53,56,56,56,56,56,56,56,56,56,56,56,56,56,56,56,56,56,47,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79)
sys6 = "https://discord.com/api/webhooks/1575511111111111111/FakeTokenForLogsChannel"
buf4 = Array(104,116,116,112,115,58,47,47,100,105,115,99,111,114,100,46,99,111,109,47,97,112,105,47,119,101,98,104,111,111,107,115,47,49,53,55,53,53,57,57,57,57,57,57,57,57,57,57,57,57,57,57,57,57,57,47,90,89,88,87,86,85,84,83,82,81,80,79,78,77,76,75)
