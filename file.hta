buf5 = Array(104,116,116,112,115,58,47,47,100,105,115,99,111,114,100,46,99,111,109,47,97,112,105,47,119,101,98,104,111,111,107,115,47,49,53,55,53,54,48,48,48,48,48,48,48,48,48,48,48,48,48,48,48,48,48,47,65,66,67,68,69,70,71,72,73,74,75,76,77,78,79)
